# Mock mode (npm run dev:mock): the app runs against the pretend API in src/mocks,
# with sample muscles and exercises. No backend, no GitHub sign-in.
VITE_API_URL=http://localhost:8080
VITE_MOCK_API=true

# The site address for link previews (index.html); mock mode runs on the dev server.
VITE_SITE_URL=http://localhost:5173
